{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracemind.local/schemas/ai-project-state-v1.json",
  "title": "AI Project Management State",
  "type": "object",
  "required": ["schema_version", "project", "objectives", "features", "milestones", "weeks"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"$ref": "#/$defs/project"},
    "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objective"}},
    "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/feature"}},
    "milestones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestone"}},
    "weeks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/week"}},
    "execution_log": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "experiments": {"type": "array", "items": {"$ref": "#/$defs/experiment"}},
    "research_topics": {"type": "array", "items": {"$ref": "#/$defs/research_topic"}},
    "work_logs": {"$ref": "#/$defs/work_logs"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "linkList": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}},
    "project": {"type": "object", "required": ["id", "name"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "name": {"$ref": "#/$defs/nonEmpty"}, "name_source": {"type": "string"}, "timezone": {"type": "string"}, "progress": {"type": "number", "minimum": 0, "maximum": 100}, "baseline_rebased_from": {"type": "string"}, "baseline_rebase_reason": {"type": "string"}, "plan_rebased_from": {"type": "string"}, "plan_rebase_reason": {"type": "string"}, "source_root": {"type": "string"}, "identity_selection_reason": {"type": "string"}, "identity_evidence": {"type": "array", "items": {"type": "object", "required": ["path", "kind", "supports"], "properties": {"path": {"type": "string"}, "kind": {"type": "string"}, "supports": {"type": "string"}}}}}},
    "objective": {"type": "object", "required": ["id", "title", "key_results"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "description": {"type": "string"}, "key_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/key_result"}}}},
    "key_result": {"type": "object", "required": ["id", "metric", "target", "measurement_method"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "metric": {"$ref": "#/$defs/nonEmpty"}, "target": {"$ref": "#/$defs/nonEmpty"}, "measurement_method": {"$ref": "#/$defs/nonEmpty"}, "baseline": {}, "current": {}}},
    "feature": {"type": "object", "required": ["id", "title", "work_packages"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "description": {"type": "string"}, "weight": {"type": "number", "exclusiveMinimum": 0}, "progress": {"type": "number", "minimum": 0, "maximum": 100}, "source_evidence": {"type": "array", "items": {"type": "object", "required": ["path", "supports"], "properties": {"path": {"type": "string"}, "supports": {"type": "string"}}}}, "work_packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work_package"}}}},
    "work_package": {"type": "object", "required": ["id", "title", "status", "description", "inputs", "outputs", "scope", "acceptance_criteria", "progress_items", "research_topic"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "status": {"enum": ["TODO", "READY", "IN_PROGRESS", "IMPLEMENTED", "VERIFYING", "DONE", "BLOCKED", "FAILED", "FIXING"]}, "description": {"$ref": "#/$defs/nonEmpty"}, "inputs": {"$ref": "#/$defs/linkList"}, "outputs": {"$ref": "#/$defs/linkList"}, "scope": {"$ref": "#/$defs/linkList"}, "dependencies": {"type": "array", "items": {"type": "string"}}, "estimate_points": {"type": "number", "exclusiveMinimum": 0}, "progress": {"type": "number", "minimum": 0, "maximum": 100}, "progress_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/progress_item"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/acceptance"}}, "research_topic": {"$ref": "#/$defs/research_topic"}, "status_history": {"type": "array", "items": {"$ref": "#/$defs/status_event"}}}},
    "progress_item": {"type": "object", "required": ["id", "weight", "done"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "weight": {"type": "number", "exclusiveMinimum": 0}, "done": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/linkList"}}},
    "acceptance": {"type": "object", "required": ["id", "method", "metric", "target"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "method": {"$ref": "#/$defs/nonEmpty"}, "metric": {"$ref": "#/$defs/nonEmpty"}, "target": {"$ref": "#/$defs/nonEmpty"}, "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]}, "evidence": {"$ref": "#/$defs/linkList"}}},
    "research_topic": {"type": "object", "required": ["id", "title"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "question": {"type": "string"}, "description": {"type": "string"}, "solutions": {"type": "array", "items": {"$ref": "#/$defs/research_solution"}}}, "additionalProperties": true},
    "research_solution": {"type": "object", "required": ["id", "name", "method", "data_source"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "name": {"$ref": "#/$defs/nonEmpty"}, "method": {"$ref": "#/$defs/nonEmpty"}, "data_source": {"$ref": "#/$defs/nonEmpty"}, "conclusion": {"type": "string"}}},
    "status_event": {"type": "object", "required": ["from", "to", "evidence"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "timestamp": {"type": "string", "format": "date-time"}, "evidence": {"type": "object", "required": ["kind", "ref"], "properties": {"kind": {"$ref": "#/$defs/nonEmpty"}, "ref": {"$ref": "#/$defs/nonEmpty"}, "reason": {"type": "string"}}}}},
    "milestone": {"type": "object", "required": ["id", "title", "date", "acceptance"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "title": {"$ref": "#/$defs/nonEmpty"}, "date": {"type": "string", "format": "date"}, "acceptance": {"$ref": "#/$defs/nonEmpty"}, "status": {"type": "string"}}},
    "week": {"type": "object", "required": ["id", "start", "end", "objective", "deliverables"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "start": {"type": "string", "format": "date"}, "end": {"type": "string", "format": "date"}, "objective": {"$ref": "#/$defs/nonEmpty"}, "deliverables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmpty"}}, "work_package_ids": {"type": "array", "items": {"type": "string"}}}},
    "event": {"type": "object", "required": ["id", "timestamp", "kind", "summary", "evidence_links"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "timestamp": {"type": "string", "format": "date-time"}, "kind": {"$ref": "#/$defs/nonEmpty"}, "feature_id": {"type": "string"}, "work_package_id": {"type": "string"}, "status_category": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "summary": {"$ref": "#/$defs/nonEmpty"}, "evidence_links": {"$ref": "#/$defs/linkList"}}},
    "experiment": {"type": "object", "required": ["id", "timestamp", "topic_id", "solution_id", "data_source", "hypothesis", "method", "result", "observation", "conclusion", "evidence_links", "value"], "properties": {"id": {"$ref": "#/$defs/nonEmpty"}, "timestamp": {"type": "string", "format": "date-time"}, "topic_id": {"$ref": "#/$defs/nonEmpty"}, "solution_id": {"$ref": "#/$defs/nonEmpty"}, "data_source": {"$ref": "#/$defs/nonEmpty"}, "hypothesis": {"$ref": "#/$defs/nonEmpty"}, "method": {"$ref": "#/$defs/nonEmpty"}, "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]}, "observation": {"$ref": "#/$defs/nonEmpty"}, "conclusion": {"$ref": "#/$defs/nonEmpty"}, "evidence_links": {"$ref": "#/$defs/linkList"}, "value": {"type": "object", "required": ["impact", "novelty", "learning", "reuse"], "properties": {"impact": {"type": "integer", "minimum": 1, "maximum": 5}, "novelty": {"type": "integer", "minimum": 1, "maximum": 5}, "learning": {"type": "integer", "minimum": 1, "maximum": 5}, "reuse": {"type": "integer", "minimum": 1, "maximum": 5}}}}},
    "work_logs": {"type": "object", "properties": {"daily": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "weekly": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "monthly": {"type": "array", "items": {"$ref": "#/$defs/event"}}}}
  }
}
